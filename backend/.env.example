# PromptBench backend environment variables
# Copy this file to .env in this directory before running the backend:
#   cp .env.example .env
#
# NEVER commit .env — it contains API keys and secrets.

# --- Database ---
# Default: SQLite (development only — see docker-compose.yml for PostgreSQL)
# DATABASE_URL=sqlite:///./promptbench.db

# --- AI Provider API Keys ---
# Get keys from each provider's developer console.
# OpenRouter keys start with sk-or-v1- (not sk-proj- which is OpenAI).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Local Providers (no API key needed) ---
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8001

# --- Cache (Redis with in-memory fallback) ---
# Leave REDIS_URL empty to use a process-local in-memory cache.
# When set and Redis is unreachable, PromptBench automatically falls back to
# the in-memory cache without crashing.
# REDIS_URL=redis://localhost:6379/0
# CACHE_ENABLED=true
# TTLs in seconds (defaults: 30 min for responses, 24 h for embeddings).
# CACHE_TTL_RESPONSE=1800
# CACHE_TTL_EMBEDDING=86400
